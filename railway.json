{
  "$schema": "https://railway.app/schema.json",
  "name": "Job Scraper Backend",
  "description": "FastAPI Job Scraper with Real-time Filtering",
  "keywords": ["fastapi", "python", "jobs", "api", "docker"],
  "gitRepo": "https://github.com/SaqlainShahid/Job-scrapper",
  "gitBranch": "main",
  "port": 8000,
  "startCommand": "uvicorn app:app --host 0.0.0.0 --port $PORT",
